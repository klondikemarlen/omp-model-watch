{
  "name": "omp-model-watch",
  "version": "0.3.0",
  "description": "Passive OMP hints for newly listed provider models.",
  "type": "module",
  "private": true,
  "bin": {
    "model-watch": "./bin/model-watch.js"
  },
  "files": [
    "index.js",
    "bin",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "omp": {
    "settings": {
      "checkIntervalHours": {
        "type": "number",
        "description": "Hours between successful catalog checks",
        "default": 6,
        "min": 1,
        "max": 596
      }
    },
    "extensions": [
      "./index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondikemarlen/omp-model-watch.git"
  }
}
